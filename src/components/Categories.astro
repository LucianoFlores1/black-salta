---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { CATEGORIES, MAIN_WHATSAPP, SOCIALS, waLink } from '../data/site';

/** Composición del mosaico en escritorio (grilla de 6 columnas). */
const layout: Record<string, string> = {
  smartwatch: 'lg:col-span-3 lg:row-span-2',
  auriculares: 'lg:col-span-3',
  tvbox: 'lg:col-span-3',
  parlantes: 'lg:col-span-2',
  proyectores: 'lg:col-span-2',
  'luces-led': 'lg:col-span-2',
  cables: 'lg:col-span-3',
  hogar: 'lg:col-span-3',
};

const instagram = SOCIALS[0];
---

<section id="productos" class="pb-24 pt-10 md:pb-36 md:pt-12">
  <div class="wrap">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h2 class="display max-w-[16ch] text-[clamp(2.25rem,5vw,3.75rem)]" data-reveal>Lo que buscás, en un solo lugar.</h2>
      <p class="max-w-[26rem] text-lg leading-relaxed text-mute" data-reveal style="--d:120">
        Consultá stock y precio por WhatsApp. Te responde una persona del local, no un bot.
      </p>
    </div>

    <!-- En celular: carrusel horizontal con scroll nativo y la tarjeta siguiente asomando. Desde md: mosaico. -->
    <ul
      class="rail -mx-5 mt-10 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-1 md:mx-0 md:mt-16 md:grid md:snap-none md:grid-cols-2 md:overflow-visible md:px-0 md:pb-0 lg:auto-rows-[22rem] lg:grid-cols-6"
      data-rail
      data-reveal-stagger
      aria-label="Categorías de productos"
    >
      {
        CATEGORIES.map((cat, i) => (
          <li class={`w-[78%] flex-none snap-start md:w-auto ${layout[cat.id] ?? 'lg:col-span-2'} ${i === 0 ? 'md:col-span-2' : ''}`}>
            <a
              href={waLink(MAIN_WHATSAPP, `Hola Black, quiero consultar por ${cat.name.toLowerCase()}.`)}
              target="_blank"
              rel="noopener"
              class="tile group flex h-full flex-col overflow-hidden rounded-2xl bg-surface-2"
            >
              <span class="relative block aspect-square overflow-hidden md:aspect-[4/3] lg:aspect-auto lg:min-h-0 lg:flex-1">
                <Image
                  src={cat.image}
                  alt={cat.alt}
                  widths={[480, 800, 1200]}
                  sizes={i === 0 ? '(min-width: 1024px) 600px, (min-width: 768px) 100vw, 78vw' : '(min-width: 1024px) 600px, (min-width: 768px) 50vw, 78vw'}
                  class="tile-img absolute inset-0 size-full object-cover"
                  style={cat.focus ? `object-position: ${cat.focus}` : undefined}
                />
                {cat.badge && (
                  <span class="absolute left-4 top-4 rounded-full bg-fg px-3 py-1 text-xs font-medium text-ink">{cat.badge}</span>
                )}
              </span>
              <span class="flex flex-1 flex-col items-start gap-3 p-5 md:flex-none md:flex-row md:items-end md:justify-between md:gap-4 md:p-6">
                <span>
                  <span class="block text-xl font-semibold tracking-[-0.02em] md:text-2xl">{cat.name}</span>
                  <span class="mt-1 block max-w-[34ch] text-[0.9375rem] text-mute">{cat.blurb}</span>
                </span>
                <span class="inline-flex flex-none items-center gap-1 text-[0.9375rem] font-medium text-link">
                  Consultar
                  <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5" />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-3 flex justify-center md:hidden" aria-hidden="true" data-rail-dots>
      {
        CATEGORIES.map((_, i) => (
          <button type="button" tabindex="-1" class="grid h-8 place-items-center px-[3px]" data-dot={i}>
            <span class={`rail-dot ${i === 0 ? 'is-active' : ''}`} />
          </button>
        ))
      }
    </div>

    <p class="mt-6 text-mute md:mt-8" data-reveal>
      Ingresan productos nuevos todas las semanas.
      <a href={instagram.href} class="link" target="_blank" rel="noopener">
        Miralos en Instagram <Icon name="arrow-up-right" size={15} />
      </a>
    </p>
  </div>
</section>

<style>
  .rail {
    scroll-behavior: smooth;
    scrollbar-width: none;
    scroll-padding-inline: 1.25rem;
    overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: #48484a;
    transition: width 0.4s var(--ease-out-expo), background-color 0.3s;
  }
  .rail-dot.is-active {
    width: 1.25rem;
    background: var(--color-fg);
  }
  /* Gradación común: unifica la temperatura de las fotos provisorias sobre el negro. */
  .tile {
    transition: transform 0.16s var(--ease-out-expo);
    -webkit-touch-callout: none;
  }
  .tile:active {
    transform: scale(0.985);
  }
  .tile-img {
    filter: saturate(0.6) brightness(0.82) contrast(1.08);
    transition:
      transform 1.2s var(--ease-out-expo),
      filter 0.6s var(--ease-out-expo);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover .tile-img {
      transform: scale(1.035);
      filter: saturate(0.9) brightness(0.92) contrast(1.05);
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-rail-dots] .rail-dot'));
  const dotButtons = document.querySelectorAll<HTMLButtonElement>('[data-rail-dots] [data-dot]');

  if (rail && dots.length) {
    let frame = 0;
    const sync = () => {
      frame = 0;
      const items = Array.from(rail.children) as HTMLElement[];
      const left = rail.scrollLeft;
      let active = 0;
      items.forEach((item, i) => {
        if (Math.abs(item.offsetLeft - rail.offsetLeft - left) < Math.abs(items[active].offsetLeft - rail.offsetLeft - left)) active = i;
      });
      // Al llegar al final, la última tarjeta queda activa aunque no se alinee al inicio.
      if (left + rail.clientWidth >= rail.scrollWidth - 4) active = items.length - 1;
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
    };
    rail.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(sync);
    }, { passive: true });

    // Tocar un punto lleva a esa tarjeta.
    dotButtons.forEach((button) =>
      button.addEventListener('click', () => {
        const item = rail.children[Number(button.dataset.dot)] as HTMLElement | undefined;
        if (item) rail.scrollTo({ left: item.offsetLeft - rail.offsetLeft - parseFloat(getComputedStyle(rail).paddingLeft) });
      }),
    );
  }
</script>
