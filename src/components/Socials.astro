---
import Icon from './Icon.astro';
import { SOCIALS } from '../data/site';
---

<section id="redes" class="border-t border-line py-24 md:py-32">
  <div class="wrap">
    <h2 class="display max-w-[18ch] text-[clamp(2rem,4.4vw,3.25rem)]">
      Las ofertas salen primero en redes.
    </h2>
    <ul class="mt-12 grid border-t border-line md:grid-cols-3 md:border-t-0">
      {
        SOCIALS.map((s) => (
          <li class="border-b border-line md:border-b-0 md:border-l md:first:border-l-0 md:[&:not(:first-child)]:pl-8">
            <a href={s.href} target="_blank" rel="noopener" class="group flex items-center gap-5 py-7 md:flex-col md:items-start md:gap-6 md:py-2">
              <Icon name={s.id} size={30} class="flex-none" />
              <span class="flex-1">
                <span class="block text-xl font-semibold tracking-[-0.015em]">{s.handle}</span>
                <span class="mt-1 block text-mute">
                  {s.label} · {s.note}
                </span>
              </span>
              <Icon
                name="arrow-up-right"
                size={20}
                class="flex-none text-mute transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-fg md:hidden"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
