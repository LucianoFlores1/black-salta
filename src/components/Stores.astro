---
import Icon from './Icon.astro';
import { STORES, POSVENTA, waLink } from '../data/site';

const posventaWa = waLink(POSVENTA.phone, 'Hola, tengo una consulta de garantía / cambio de un producto.');
---

<section id="pos-venta" class="relative overflow-hidden border-t border-line bg-surface py-24 md:py-32">
  <div class="wrap grid gap-12 md:grid-cols-[1.2fr_1fr] md:items-end">
    <div>
      <h2 class="display text-[clamp(2.25rem,5.4vw,4.25rem)]">
        ¿Algo no anda?<br /><span class="text-mute">Tiene dirección.</span>
      </h2>
      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-mute">
        En Mendoza 710 tenemos un local dedicado solo a pos venta: cambios y garantía, de lunes a sábados de 9 a 21. Traé
        tu producto o escribinos antes y te decimos cómo seguir.
      </p>
    </div>

    <div class="md:justify-self-end md:text-right">
      <p class="hidden text-[clamp(4.5rem,12vw,8.5rem)] font-semibold leading-none tracking-[-0.05em] md:block" aria-hidden="true">710</p>
      <p class="inline-flex items-center gap-2 text-sm text-mute md:mt-3" data-store-status={POSVENTA.id} data-state="unknown">
        <span class="status-dot"></span>
        <span data-status-text>{POSVENTA.hoursText[0]}</span>
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row md:mt-7 md:justify-end">
        <a href={posventaWa} target="_blank" rel="noopener" class="btn btn-primary">
          <Icon name="whatsapp" size={18} />
          Escribir a pos venta
        </a>
        <a href={POSVENTA.maps} target="_blank" rel="noopener" class="btn btn-ghost">
          <Icon name="map-pin" size={18} />
          Cómo llegar
        </a>
      </div>
    </div>
  </div>
</section>

<section id="locales" class="border-t border-line py-24 md:py-36">
  <div class="wrap">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h2 class="display max-w-[14ch] text-[clamp(2.25rem,5vw,3.75rem)]">Vení a verlo en persona.</h2>
      <p class="max-w-[26rem] text-lg leading-relaxed text-mute">
        Tres locales a pocas cuadras, en el centro de Salta. Cada uno con su propio WhatsApp.
      </p>
    </div>

    <ul class="mt-14 border-t border-line md:mt-20">
      {
        STORES.map((store) => (
          <li class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-4 gap-y-5 border-b border-line py-8 md:grid-cols-[9rem_1fr_1fr_auto] md:items-start md:gap-x-10 md:py-11">
            <p class="row-span-2 text-[2.5rem] font-semibold leading-[0.9] tracking-[-0.05em] md:row-span-1 md:text-[4.25rem]" aria-hidden="true">
              {store.number}
            </p>

            <div>
              <h3 class="text-xl font-semibold tracking-[-0.015em]">{store.street}</h3>
              <p class="mt-1 text-mute">
                {store.name} · {store.role}
              </p>
              <p class="mt-4 inline-flex items-center gap-2 text-sm text-mute" data-store-status={store.id} data-state="unknown">
                <span class="status-dot" />
                <span data-status-text>Consultá el horario</span>
              </p>
            </div>

            <dl class="text-mute">
              <dt class="sr-only">Horario</dt>
              {store.hoursText.map((line) => (
                <dd class="leading-relaxed">{line}</dd>
              ))}
              <dt class="sr-only">Teléfono</dt>
              <dd class="mt-2">
                <a href={`tel:+${store.phone}`} class="tabular-nums text-fg transition-colors hover:text-link">
                  {store.phoneDisplay}
                </a>
              </dd>
            </dl>

            <div class="col-span-2 grid grid-cols-2 gap-2 md:col-span-1 md:flex md:flex-col md:items-stretch">
              <a
                href={waLink(store.phone, `Hola, quería consultar en el local de ${store.street}.`)}
                target="_blank"
                rel="noopener"
                class="btn btn-primary !min-h-11 !px-5 text-[0.9375rem]"
                aria-label={`WhatsApp del local ${store.street}`}
              >
                <Icon name="whatsapp" size={17} />
                WhatsApp
              </a>
              <a
                href={store.maps}
                target="_blank"
                rel="noopener"
                class="btn btn-ghost !min-h-11 !px-5 text-[0.9375rem]"
                aria-label={`Cómo llegar a ${store.street}`}
              >
                <Icon name="map-pin" size={17} />
                Cómo llegar
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { STORES, SITE } from '../data/site';
  import { storeStatus, zonedNow } from '../scripts/hours';

  function update() {
    const now = zonedNow(SITE.timeZone);
    document.querySelectorAll<HTMLElement>('[data-store-status]').forEach((el) => {
      const store = STORES.find((s) => s.id === el.dataset.storeStatus);
      if (!store) return;
      const status = storeStatus(store, now);
      el.dataset.state = status.open ? 'open' : 'closed';
      const text = el.querySelector('[data-status-text]');
      if (text) text.textContent = status.label;
    });
  }

  update();
  setInterval(update, 60_000);
</script>
